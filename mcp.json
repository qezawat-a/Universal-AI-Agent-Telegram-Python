{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/root/jrock"],
      "enabled": true,
      "description": "Local file read/list"
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"],
      "enabled": true,
      "description": "Web fetch"
    },
    "sqlite": {
      "command": "uvx",
      "args": ["mcp-server-sqlite", "--db-path", "/root/jrock/agent.db"],
      "enabled": true,
      "description": "SQLite memory"
    },
    "bitunix": {
      "command": "bitunix-mcp",
      "args": [],
      "env": {
        "BITUNIX_API_KEY": "$BITUNIX_API_KEY",
        "BITUNIX_SECRET_KEY": "$BITUNIX_SECRET_KEY",
        "BITUNIX_ENABLE_TRADING": "$BITUNIX_ENABLE_TRADING"
      },
      "enabled": true,
      "description": "Bitunix exchange Spot+Futures (read-only unless BITUNIX_ENABLE_TRADING=true)"
    }
  }
}
